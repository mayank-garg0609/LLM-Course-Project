# ---- model server running on Kaggle (printed by kaggle/kaggle_notebook.ipynb) ----
KAGGLE_URL=https://xxxx.trycloudflare.com
KAGGLE_API_KEY=

# ---- which hosted model plays which role ----
VERIFIER_MODEL=flan-t5      # judges claims (T5-based)
UPSTREAM_MODEL=gpt-neo      # the "company LLM" being audited (GPT-Neo)

# ---- proxy behaviour ----
AUDIT_MODE=monitor          # monitor = log only (start here) | enforce = apply actions
FAIL_MODE=open              # open = deliver draft if the auditor fails | closed = block
PROXY_API_KEY=              # optional: clients must send this as Bearer token
APPEND_SOURCES=true
LOG_CONTENT=false           # true stores queries/answers in results/audit_log.jsonl
# PRIVATE_REGEX=ProjectX;;\b\d{10}\b     # claims matching these never go to web search
